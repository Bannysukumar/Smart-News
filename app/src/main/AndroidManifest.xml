<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet Permission -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Notification Permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Storage Permission for offline caching -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    
    <!-- Vibration Permission for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Way2news"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true">

        <!-- Google Mobile Ads App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        
        <!-- Fix manifest merger conflict between AdMob and Firebase Analytics -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />
        
        <!-- Splash Activity -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Way2news.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <!-- Language Selection Activity -->
        <activity
            android:name=".activities.LanguageSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <!-- News Details Activity -->
        <activity
            android:name=".activities.NewsDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <!-- Settings Activity -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <!-- Authentication Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <activity
            android:name=".activities.SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <!-- Admin Activities -->
        <activity
            android:name=".activities.AdminLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <activity
            android:name=".activities.AddNewsActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <activity
            android:name=".activities.NotificationsActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <activity
            android:name=".activities.PendingSubmissionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <activity
            android:name=".activities.UserEditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <activity
            android:name=".activities.FollowersFollowingActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <activity
            android:name=".activities.UserProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Way2news" />
        
        <!-- Comments Activity -->
        <activity
            android:name=".activities.CommentsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Way2news" />
        
        <!-- Firebase Messaging Service -->
        <service
            android:name=".services.NewsFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        
    </application>

</manifest>